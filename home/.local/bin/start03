#!/bin/sh
# The existing startup route is startx -> ~/.xinitrc -> i3.
if [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}${I3SOCK:-}" ]; then
    echo 'A graphical session is already selected. Use: air-theme charcoal' >&2
    exit 1
fi
case "${XDG_SESSION_TYPE:-}" in
    x11|wayland)
        echo 'A graphical session is already running. Use: air-theme charcoal' >&2
        exit 1 ;;
esac
if ! tty | grep -Eq '^/dev/tty[0-9]+$'; then
    echo 'Run start03 from a local Linux virtual console.' >&2
    exit 1
fi
"$HOME/.local/bin/air-theme" charcoal || exit $?
exec startx "$@"
