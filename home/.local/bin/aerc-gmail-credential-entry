#!/usr/bin/python3
"""Run by the user in a separate terminal, never in the agent session."""
import getpass
import json
import os
import re
import sys
from pathlib import Path

os.umask(0o077)
base = Path.home() / '.local/share/aerc-private'
if not sys.stdin.isatty() or not sys.stderr.isatty():
    sys.exit('Run this helper yourself in a separate interactive terminal.')
base.mkdir(mode=0o700, parents=True, exist_ok=True)
if base.is_symlink():
    sys.exit('Refusing a symlink credential directory.')
base.chmod(0o700)
identity = base / 'identity.json'
if identity.exists():
    data = json.loads(identity.read_text())
else:
    address = input('Gmail address: ').strip()
    if not re.fullmatch(r'[A-Za-z0-9.!#$%&\x27*+/=?^_`{|}~-]+@[A-Za-z0-9.-]+', address):
        sys.exit('Invalid email address.')
    name = input('Sender display name: ').strip()
    if not name or any(c in name for c in '\r\n'):
        sys.exit('A display name is required.')
    kind = input('Account type (personal or managed): ').strip().lower()
    if kind not in ('personal', 'managed'):
        sys.exit('Enter personal or managed.')
    data = dict(address=address, name=name, kind=kind)
    with identity.open('x') as f:
        json.dump(data, f)
print('Enter only the dedicated Google app password, never your normal password.')
print('Storage is plaintext while the LUKS disk is unlocked.')
password = ''.join(getpass.getpass('Arch Air aerc app password (hidden): ').split())
if not re.fullmatch(r'[A-Za-z]{16}', password):
    sys.exit('Expected a 16-letter Google app password; nothing was stored.')
target = base / 'gmail-app-password'
temp = base / 'gmail-app-password.new'
fd = os.open(temp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
with os.fdopen(fd, 'w') as f:
    f.write(password + '\n')
    f.flush()
    os.fsync(f.fileno())
os.replace(temp, target)
print('Credential stored privately. Tell the assistant: credential ready.')
