#!/bin/sh

set -eu

runtime_dir="${XDG_RUNTIME_DIR:-/tmp}"
pid_file="$runtime_dir/nerd-dictation.pid"
log_file="$runtime_dir/nerd-dictation.log"

notify() {
    dunstify -a 'Voice typing' -r 7412 'Voice typing' "$1" >/dev/null 2>&1 || true
}

if [ -r "$pid_file" ]; then
    dictation_pid="$(sed -n '1p' "$pid_file")"
    dictation_args="$(ps -p "$dictation_pid" -o args= 2>/dev/null || true)"
    case "$dictation_args" in
        *nerd-dictation*begin*)
            nerd-dictation end
            rm -f "$pid_file"
            notify 'Finishing and typing the transcript.'
            exit 0
            ;;
    esac
fi

rm -f "$pid_file"
nohup nerd-dictation begin \
    --input=PW-CAT \
    --continuous \
    --full-sentence \
    --idle-time=0.25 \
    >/dev/null 2>"$log_file" &
printf '%s\n' "$!" > "$pid_file"
notify 'Listening. Press Super+Shift+V again to finish.'
