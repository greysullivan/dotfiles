# Pink and White theme for btop
# Matching fastfetch icon colors with pink and white accents

# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]=""

# Main text color
theme[main_fg]="#ffffff"

# Title color for boxes
theme[title]="#ff69b4"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#ff1493"

# Background color of selected item in processes box
theme[selected_bg]="#ff69b4"

# Foreground color of selected item in processes box
theme[selected_fg]="#ffffff"

# Color of inactive/disabled text
theme[inactive_fg]="#ffc0cb"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#ff1493"

# Background color of the percentage meters
theme[meter_bg]="#4d4d4d"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#ff69b4"

# Cpu box outline color
theme[cpu_box]="#ff1493"

# Memory/disks box outline color
theme[mem_box]="#ff69b4"

# Net up/down box outline color
theme[net_box]="#ffb6c1"

# Processes box outline color
theme[proc_box]="#ff1493"

# Box divider line and small boxes line color
theme[div_line]="#ffc0cb"

# Temperature graph colors (white to pink to hot pink)
theme[temp_start]="#ffffff"
theme[temp_mid]="#ff69b4"
theme[temp_end]="#ff1493"

# CPU graph colors (white to pink to hot pink)
theme[cpu_start]="#ffffff"
theme[cpu_mid]="#ffb6c1"
theme[cpu_end]="#ff1493"

# Mem/Disk free meter (hot pink to pink to white)
theme[free_end]="#ffffff"
theme[free_mid]="#ffb6c1"
theme[free_start]="#ff1493"

# Mem/Disk cached meter (white to pink)
theme[cached_start]="#ffffff"
theme[cached_mid]="#ffc0cb"
theme[cached_end]="#ff69b4"

# Mem/Disk available meter (hot pink to white)
theme[available_start]="#ff1493"
theme[available_mid]="#ffc0cb"
theme[available_end]="#ffffff"

# Mem/Disk used meter (white to hot pink)
theme[used_start]="#ffffff"
theme[used_mid]="#ff69b4"
theme[used_end]="#ff1493"

# Download graph colors (white to pink to hot pink)
theme[download_start]="#ffffff"
theme[download_mid]="#ff69b4"
theme[download_end]="#ff1493"

# Upload graph colors (white to pink to hot pink)
theme[upload_start]="#ffffff"
theme[upload_mid]="#ffb6c1"
theme[upload_end]="#ff1493"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#ffc0cb"
theme[process_mid]="#ff69b4"
theme[process_end]="#ff1493"
