{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/manjaro-short.txt",
    "type": "file-raw",
    "padding": {
      "top": 0,
      "left": 0,
      "right": 1
    }
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "#ddb6f2",
        "at": "#ddb6f2",
        "host": "#ddb6f2"
      }
    },
    {
      "type": "os",
      "key": "OS",
      "keyColor": "#8E5EBB"
    },
    {
      "type": "host",
      "key": "Host",
      "keyColor": "#8E5EBB",
      "format": "MacBook Air {##ddb6f2}(13-inch,Early 2017){#}"
    },
    {
      "type": "kernel",
      "key": "Kernel",
      "keyColor": "#8E5EBB"
    },
    {
      "type": "packages",
      "key": "Packages",
      "keyColor": "#8E5EBB",
      "format": "{all} {##ddb6f2}(pacman)[{pacman-branch}]{#}"
    },
    {
      "type": "shell",
      "key": "Shell",
      "keyColor": "#8E5EBB"
    },
    {
      "type": "wm",
      "key": "WM",
      "keyColor": "#8E5EBB",
      "format": "{pretty-name} {##ddb6f2}({protocol-name}){#}"
    },
    {
      "type": "terminal",
      "key": "Terminal",
      "keyColor": "#8E5EBB"
    },
    {
      "type": "terminalfont",
      "key": "Terminal Font",
      "keyColor": "#8E5EBB",
      "format": "JetbrainsMono Nerd (11pt)"
    },
    {
      "type": "memory",
      "key": "Memory",
      "keyColor": "#8E5EBB",
      "format": "{used} / {total} {##ddb6f2}({##FFFFFF}{percentage}{##ddb6f2}){#}"
    },
    {
      "type": "disk",
      "key": "Disk",
      "keyColor": "#8E5EBB",
      "format": "{size-used} / {size-total} {##ddb6f2}({##FFFFFF}{size-percentage}{##ddb6f2}){#}"
    },
  ]
}
