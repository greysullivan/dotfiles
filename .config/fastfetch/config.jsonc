{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "display": {
    "color": {
      "output": "#888888"
    }
  },
  "logo": {
    "source": "~/.config/fastfetch/manjaro-short.txt",
    "type": "file-raw",
    "padding": {
      "top": 0,
      "left": 0,
      "right": 1
    }
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "#888888",
        "at": "#888888",
        "host": "#888888"
      }
    },
    {
      "type": "os",
      "key": "OS",
      "keyColor": "#d8e2e8"
    },
    {
      "type": "host",
      "key": "Host",
      "keyColor": "#d8e2e8",
      "format": "MacBook Air {##AFC9AF}(13-inch,Early 2017){#}"
    },
    {
      "type": "kernel",
      "key": "Kernel",
      "keyColor": "#d8e2e8"
    },
    {
      "type": "packages",
      "key": "Packages",
      "keyColor": "#d8e2e8",
      "format": "{all} {##AFC9AF}(pacman)[{pacman-branch}]{#}"
    },
    {
      "type": "shell",
      "key": "Shell",
      "keyColor": "#d8e2e8"
    },
    {
      "type": "wm",
      "key": "WM",
      "keyColor": "#d8e2e8",
      "format": "{pretty-name} {##AFC9AF}({protocol-name}){#}"
    },
    {
      "type": "terminal",
      "key": "Terminal",
      "keyColor": "#d8e2e8"
    },
    {
      "type": "terminalfont",
      "key": "Terminal Font",
      "keyColor": "#d8e2e8",
      "format": "JetbrainsMono Nerd (11pt)"
    },
    {
      "type": "memory",
      "key": "Memory",
      "keyColor": "#d8e2e8",
      "format": "{used} / {total} {##AFC9AF}({percentage}){#}"
    },
    {
      "type": "disk",
      "key": "Disk",
      "keyColor": "#d8e2e8",
      "format": "{size-used} / {size-total} {##AFC9AF}({size-percentage}){#}"
    },
    {
      "type": "locale",
      "key": "Locale",
      "keyColor": "#d8e2e8"
    },
  ]
}
