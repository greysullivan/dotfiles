[general]
bars = 22
framerate = 60
lower_cutoff_freq = 50
higher_cutoff_freq = 4000
sensitivity = 30
autosens = 0
bar_height = 13

[input]
method = pipewire
source = alsa_output.pci-0000_00_1b.0.analog-stereo.monitor

[output]
method = ncurses

[smoothing]
noise_reduction = 92
integral = 95
monstercat = 0

[colors]
gradient = 0
foreground = "#FFFFFF"
opacity = 75
