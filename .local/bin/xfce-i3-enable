#!/bin/bash
set -euo pipefail

autostart_dir="$HOME/.config/autostart"
autostart_file="$autostart_dir/i3-xfce.desktop"

mkdir -p "$autostart_dir"

cat >"$autostart_file" <<'EOF'
[Desktop Entry]
Type=Application
Name=i3 (replace xfwm4)
Comment=Use i3 as the window manager inside XFCE
Exec=i3 --replace
OnlyShowIn=XFCE;
X-GNOME-Autostart-enabled=true
NoDisplay=false
EOF

if command -v xfconf-query >/dev/null 2>&1; then
  xfconf-query -c xfce4-session -p /general/WindowManager -n -t string -s i3 >/dev/null 2>&1 || true
fi

if [ -n "${DISPLAY:-}" ] && command -v i3 >/dev/null 2>&1; then
  i3 --replace >/dev/null 2>&1 || true
fi

echo "i3 enablement prepared."
echo "Log out and back in for a clean XFCE+i3 session."
