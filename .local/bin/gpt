#!/usr/bin/env python3
import sys, os, subprocess

# Relaunch as a detached process if not already
if os.environ.get('GPT_DETACHED') != '1':
    env = os.environ.copy()
    env['GPT_DETACHED'] = '1'
    subprocess.Popen(
        [sys.executable, __file__],
        env=env,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    sys.exit(0)

import gi
gi.require_version('Gtk', '3.0')
gi.require_version('WebKit2', '4.1')
from gi.repository import Gtk, WebKit2, GLib

GLib.set_prgname('gpt')

URL = 'https://chatgpt.com'
DATA_DIR = GLib.get_home_dir() + '/.local/share/gpt-window'

class GPTWindow(Gtk.Window):
    def __init__(self):
        super().__init__(title='ChatGPT')
        self.set_wmclass('gpt', 'gpt')
        self.set_default_size(1000, 800)
        self.connect('destroy', Gtk.main_quit)

        data_manager = WebKit2.WebsiteDataManager(
            base_data_directory=DATA_DIR,
            base_cache_directory=DATA_DIR + '/cache',
        )
        context = WebKit2.WebContext(website_data_manager=data_manager)
        context.get_cookie_manager().set_persistent_storage(
            DATA_DIR + '/cookies.db',
            WebKit2.CookiePersistentStorage.SQLITE,
        )

        self.webview = WebKit2.WebView.new_with_context(context)
        self.webview.load_uri(URL)

        settings = self.webview.get_settings()
        settings.set_enable_javascript(True)
        settings.set_enable_media(True)

        self.add(self.webview)
        self.show_all()

win = GPTWindow()
Gtk.main()
