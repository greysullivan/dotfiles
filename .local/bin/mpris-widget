#!/usr/bin/env bash

BAR_LENGTH=60

# subtle gradient steps
GRADIENT=( " " "▏" "▎" "▍" "▌" "▋" "▊" "█" )

get_clean_url() {
    url="$1"
    # strip protocol, query params, fragments
    url="${url#http://}"
    url="${url#https://}"
    url="${url%%\?*}"
    url="${url%%\#*}"
    echo "$url"
}

while true; do
    status=$(playerctl status 2>/dev/null)

    if [[ "$status" == "Playing" || "$status" == "Paused" ]]; then
        # pull metadata
        artist=$(playerctl metadata artist 2>/dev/null | tr '[:upper:]' '[:lower:]')
        title=$(playerctl metadata title 2>/dev/null | tr '[:upper:]' '[:lower:]')

        # fallback title & url
        if [[ -z "$title" ]]; then
            title=$(playerctl metadata xesam:title 2>/dev/null | tr '[:upper:]' '[:lower:]')
        fi
        url=$(playerctl metadata xesam:url 2>/dev/null)
        clean_url=$(get_clean_url "$url" | tr '[:upper:]' '[:lower:]')

        # no artist? use only title or url
        if [[ -z "$artist" && -n "$title" ]]; then
            meta="$title"
        elif [[ -n "$artist" && -n "$title" ]]; then
            meta="$artist - $title"
        elif [[ -n "$clean_url" ]]; then
            meta="$clean_url"
        else
            meta="unknown audio"
        fi

        # progress
        pos=$(playerctl position 2>/dev/null)
        dur=$(playerctl metadata mpris:length 2>/dev/null)
        dur_sec=$((dur / 1000000))

        if [[ $dur_sec -gt 0 ]]; then
            percent=$(echo "$pos / $dur_sec" | bc -l)
        else
            percent=0
        fi

        # build subtle gradient bar
        filled=$(printf "%.0f" "$(echo "$percent * $BAR_LENGTH" | bc -l)")
        raw=$(echo "$percent * $BAR_LENGTH" | bc -l)
        fractional=$(echo "$raw - $filled" | bc -l)
        gradient_index=$(printf "%.0f" "$(echo "$fractional * 7" | bc -l)")

        # clamp index
        ((gradient_index<0)) && gradient_index=0
        ((gradient_index>7)) && gradient_index=7

        bar=""
        for ((i=0; i<filled; i++)); do
            bar+="█"
        done

        if [[ $filled -lt $BAR_LENGTH ]]; then
            bar+="${GRADIENT[$gradient_index]}"
            for ((i=filled+1; i<BAR_LENGTH; i++)); do
                bar+=" "
            done
        fi

        clear
        echo "$meta"
        echo "$bar"
    else
        clear
        echo "no audio"
    fi

    sleep 0.3
done

