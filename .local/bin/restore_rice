#!/bin/bash

backup_root="$HOME/rice_backups"

# require name
if [ -z "$1" ]; then
    echo "Usage: restore_rice <backup_name>"
    echo "Example: restore_rice rice_20260130_1418"
    exit 1
fi

backup_name="$1"
backup_dir="$backup_root/$backup_name"

# check it exists
if [ ! -d "$backup_dir" ]; then
    echo "Error: backup '$backup_name' not found in $backup_root"
    exit 1
fi

echo ">>> Restoring rice from: $backup_dir"
echo ">>> Press Ctrl+C now if this is not what you want."
sleep 2

# restore configs
cp -r "$backup_dir/xfce4"         "$HOME/.config/" 2>/dev/null
cp -r "$backup_dir/btop"          "$HOME/.config/" 2>/dev/null
cp -r "$backup_dir/cava"          "$HOME/.config/" 2>/dev/null
cp -r "$backup_dir/fastfetch"     "$HOME/.config/" 2>/dev/null
cp -r "$backup_dir/bin"           "$HOME/.local/"  2>/dev/null

echo ">>> Rice restored."
echo ">>> Log out and back in (or reboot) to apply everything fully."
